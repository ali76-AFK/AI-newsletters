APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=newsletter
DB_USER=newsletter_user
DB_PASSWORD=newsletter_password

BACKEND_URL=http://127.0.0.1:8000

# AI provider: mock | ollama | groq
LLM_PROVIDER=groq

# Ollama local model (optional)
OLLAMA_MODEL=llama3.1:8b

# Groq API key (required for groq mode)
GROQ_API_KEY=your_groq_api_key_here


# IMPORTANT: set this to a supported Groq model from Groq docs.
GROQ_MODEL=openai/gpt-oss-20b
EMAIL_MODE=mock

# News ingestion mode: stub | rss
# Keep stub for deterministic development and tests.
NEWS_SOURCE_MODE=stub
